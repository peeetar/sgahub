# Copy to .env.local for local development. In production these are Vercel
# environment variables; real values live in the SGA password manager.

# Neon Postgres (Vercel → Storage → Neon sets this). Same database as the old merch till.
DATABASE_URL=

# Board sign-in
HUB_SECRET=                 # 32+ random characters; changing it signs everyone out
HUB_PASSWORD=               # emergency shared password, 8+ characters; also how the first person gets in
HUB_URL=                    # optional; defaults to the Vercel production URL

# The till (shared with volunteers who sell)
POS_PASSWORD=

# The vault (Settings → Vault)
VAULT_PASSWORD=             # 12+ characters, opens the vault and encrypts what's in it; not the Hub or till password
VAULT_PASSWORD_PREVIOUS=    # only while changing VAULT_PASSWORD: the old one, so Re-encrypt can move the saved values

# Alerts
NTFY_TOPIC=                 # long and hard to guess
NTFY_URL=                   # optional, defaults to https://ntfy.sh
NTFY_TOKEN=                 # optional, for a protected topic
CRON_SECRET=                # any long random string; turns on the morning jobs (posting reminder, Notion task sync)

# Files (Vercel Blob, private store)
BLOB_READ_WRITE_TOKEN=

# Meetings
GEMINI_API_KEY=
GEMINI_MODEL=               # optional, default gemini-2.5-flash
NOTION_TOKEN=               # the integration secret; needs Read, Update and Insert content (Tasks writes Done back)
NOTION_MEETINGS_DATA_SOURCE= # also where Tasks reads the open action items
NOTION_PROJECTS_DATA_SOURCE= # optional

# Coffee kiosk
KIOSK_TOKEN=                # same value as HUB_TOKEN on the Pi
PI_API_URL=                 # the Pi's public address, https://<node>.<tailnet>.ts.net
PI_API_TOKEN=               # 32+ characters, same value as HUB_API_TOKEN on the Pi

# Local development only: Neon-compatible HTTP endpoint instead of real Neon
NEON_FETCH_ENDPOINT=
GEMINI_BASE_URL=            # a local stand-in for Gemini, for testing
NOTION_BASE_URL=            # a local stand-in for Notion, for testing
